{
  "manifest_version": 3,
  "name": "Waterloo LEARN Assignment Dashboard",
  "version": "1.7.0",
  "description": "Shows assignments, quizzes, and due dates in one place while using Waterloo LEARN.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://learn.uwaterloo.ca/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://learn.uwaterloo.ca/*",
    "https://uwlearn-calendar-feed.gurshaan1124.workers.dev/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "learn-assignments@uwaterloo.ca",
      "strict_min_version": "109.0"
    }
  }
}
